{
  "name": "hold-the-floor",
  "version": "0.1.0",
  "description": "Voice AI that can see you are not finished yet. A camera-on-self turn-holding layer built on the SmartSpectra SDK.",
  "author": "Hassan",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.mts",
    "deploy:web": "npm run build:web && node scripts/web/deploy-pages.mjs",
    "start": "electron-vite build && electron .",
    "start:replay": "electron-vite build && electron . --replay",
    "probe": "electron-vite build && electron out/main/probe.js",
    "probe:analyze": "node probe/analyze.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "fixture:build": "node scripts/make-fixture.mjs",
    "ablation": "vitest run --config vitest.tools.mts tests/tools/ablation.tool.ts",
    "start:debug": "electron-vite build && electron . --htf-debug",
    "demo": "electron-vite build && electron . demo",
    "demo:script": "electron-vite build && electron . demo norec",
    "tune": "vitest run --config vitest.tools.mts tests/tools/tune.tool.ts"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
